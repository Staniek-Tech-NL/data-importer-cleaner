<Window x:Class="DataCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Importer &amp; Cleaner"
        Width="1080"
        Height="680"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Background="#0F172A" Padding="28,0">
            <DockPanel>
                <TextBlock VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="{Binding ApplicationName}" />
                <StackPanel Margin="24,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#CBD5E1"
                               Text="CSV encoding" />
                    <ComboBox Width="130"
                              Height="36"
                              Margin="0,0,12,0"
                              ItemsSource="{Binding AvailableEncodings}"
                              SelectedItem="{Binding SelectedEncoding}" />
                    <Button Width="150"
                            Height="40"
                            IsEnabled="{Binding IsImportEnabled}"
                            Click="SelectFile_Click"
                            Content="Select file" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           Text="Data preview" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="14"
                           Foreground="#64748B"
                           Text="{Binding DatasetSummary, TargetNullValue=No file selected}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,0,0,16"
                    Padding="16"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasWorksheetSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Button Width="150"
                            Height="36"
                            Margin="16,0,0,0"
                            DockPanel.Dock="Right"
                            IsEnabled="{Binding IsImportEnabled}"
                            Click="ImportWorksheet_Click"
                            Content="Import worksheet" />
                    <TextBlock Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="#1E3A8A"
                               Text="Worksheet" />
                    <ComboBox MinWidth="220"
                              Height="36"
                              ItemsSource="{Binding WorksheetNames}"
                              SelectedItem="{Binding SelectedWorksheet}" />
                </DockPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#64748B"
                               FontSize="15"
                               Text="Choose a CSV file to display its rows and inferred values." />
                    <DataGrid ItemsSource="{Binding Preview}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="All"
                              BorderThickness="0"
                              Background="White">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="ItemsSource" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#E2E8F0" Padding="28,0">
            <TextBlock VerticalAlignment="Center"
                       Foreground="#334155"
                       Text="{Binding StatusMessage}" />
        </Border>
    </Grid>
</Window>
