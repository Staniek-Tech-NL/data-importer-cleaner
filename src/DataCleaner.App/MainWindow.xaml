<Window x:Class="DataCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Importer &amp; Cleaner"
        Width="1280"
        Height="760"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Background="#0F172A" Padding="28,0">
            <DockPanel>
                <TextBlock VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="{Binding ApplicationName}" />
                <StackPanel Margin="24,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#CBD5E1"
                               Text="CSV encoding" />
                    <ComboBox Width="130"
                              Height="36"
                              Margin="0,0,12,0"
                              ItemsSource="{Binding AvailableEncodings}"
                              SelectedItem="{Binding SelectedEncoding}" />
                    <Button Width="150"
                            Height="40"
                            IsEnabled="{Binding IsImportEnabled}"
                            Click="SelectFile_Click"
                            Content="Select file" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           Text="Data preview" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="14"
                           Foreground="#64748B"
                           Text="{Binding DatasetSummary, TargetNullValue=No file selected}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,0,0,16"
                    Padding="16"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasWorksheetSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Button Width="150"
                            Height="36"
                            Margin="16,0,0,0"
                            DockPanel.Dock="Right"
                            IsEnabled="{Binding IsImportEnabled}"
                            Click="ImportWorksheet_Click"
                            Content="Import worksheet" />
                    <TextBlock Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="#1E3A8A"
                               Text="Worksheet" />
                    <ComboBox MinWidth="220"
                              Height="36"
                              ItemsSource="{Binding WorksheetNames}"
                              SelectedItem="{Binding SelectedWorksheet}" />
                </DockPanel>
            </Border>

            <TabControl Grid.Row="2"
                        Background="White"
                        BorderBrush="#CBD5E1">
                <TabItem Header="Preview">
                    <Grid>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#64748B"
                                   FontSize="15"
                                   Text="Choose a CSV or XLSX file to display its rows and inferred values." />
                        <DataGrid ItemsSource="{Binding Preview}"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="All"
                                  BorderThickness="0"
                                  Background="White">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <Trigger Property="ItemsSource" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Profile &amp; mapping"
                         IsEnabled="{Binding HasColumnProfiles}">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Profile name" />
                            <TextBox Grid.Column="1"
                                     Height="34"
                                     Margin="10,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       Text="Saved profiles" />
                            <ComboBox Grid.Column="4"
                                      Height="34"
                                      Margin="10,0,0,0"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding SavedProfiles}"
                                      SelectedItem="{Binding SelectedProfile}" />
                            <Button Grid.Column="5"
                                    Width="110"
                                    Height="34"
                                    Margin="10,0,0,0"
                                    Click="ApplyProfile_Click"
                                    Content="Apply" />
                            <Button Grid.Column="7"
                                    Width="120"
                                    Height="34"
                                    Click="SaveProfile_Click"
                                    Content="Save profile" />
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ColumnProfiles}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  FrozenColumnCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="150"
                                                    Header="Source column"
                                                    IsReadOnly="True"
                                                    Binding="{Binding SourceColumn}" />
                                <DataGridTextColumn Width="160"
                                                    Header="Target field"
                                                    Binding="{Binding TargetField, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Width="70"
                                                        Header="Ignore"
                                                        Binding="{Binding IsIgnored, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="90" Header="Type" IsReadOnly="True" Binding="{Binding TechnicalType}" />
                                <DataGridTextColumn Width="90" Header="Semantic" IsReadOnly="True" Binding="{Binding SemanticType}" />
                                <DataGridTextColumn Width="70" Header="Empty" IsReadOnly="True" Binding="{Binding EmptyCount}" />
                                <DataGridTextColumn Width="70" Header="Unique" IsReadOnly="True" Binding="{Binding UniqueCount}" />
                                <DataGridTextColumn Width="85" Header="Duplicates" IsReadOnly="True" Binding="{Binding DuplicateCount}" />
                                <DataGridTextColumn Width="70" Header="Invalid" IsReadOnly="True" Binding="{Binding InvalidCount}" />
                                <DataGridTextColumn Width="90" Header="Minimum" IsReadOnly="True" Binding="{Binding Minimum}" />
                                <DataGridTextColumn Width="90" Header="Maximum" IsReadOnly="True" Binding="{Binding Maximum}" />
                                <DataGridTextColumn Width="110" Header="Average" IsReadOnly="True" Binding="{Binding Average, StringFormat=N2}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="#E2E8F0" Padding="28,0">
            <TextBlock VerticalAlignment="Center"
                       Foreground="#334155"
                       Text="{Binding StatusMessage}" />
        </Border>
    </Grid>
</Window>
