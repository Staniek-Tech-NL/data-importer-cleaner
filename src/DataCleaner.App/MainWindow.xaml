<Window x:Class="DataCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Importer &amp; Cleaner"
        Width="1280"
        Height="760"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Data Importer and Cleaner"
        Background="#F8FAFC">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Background="#0F172A" Padding="28,0">
            <DockPanel>
                <TextBlock VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="{Binding ApplicationName}" />
                <StackPanel Margin="24,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#CBD5E1"
                               Text="Import profile" />
                    <ComboBox Width="180"
                              Height="36"
                              Margin="0,0,12,0"
                              ItemsSource="{Binding SavedProfiles}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedProfile}"
                              ToolTip="Optional saved profile applied before parsing and after profiling"
                              AutomationProperties.Name="Import profile" />
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#CBD5E1"
                               Text="Data culture" />
                    <ComboBox Width="105"
                              Height="36"
                              Margin="0,0,12,0"
                              ItemsSource="{Binding AvailableCultureNames}"
                              SelectedItem="{Binding SelectedCultureName}"
                              ToolTip="Culture used consistently for import, profiling, validation and cleaning"
                              AutomationProperties.Name="Data culture" />
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#CBD5E1"
                               Text="CSV encoding" />
                    <ComboBox Width="130"
                              Height="36"
                              Margin="0,0,12,0"
                              ItemsSource="{Binding AvailableEncodings}"
                              SelectedItem="{Binding SelectedEncoding}"
                              AutomationProperties.Name="CSV encoding" />
                    <Button Width="150"
                            Height="40"
                            IsEnabled="{Binding IsImportEnabled}"
                            Click="SelectFile_Click"
                            Content="_Select file"
                            ToolTip="Select a CSV or XLSX source file"
                            AutomationProperties.Name="Select source file" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           Text="Data preview" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="14"
                           Foreground="#64748B"
                           Text="{Binding DatasetSummary, TargetNullValue=No file selected}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,0,0,16"
                    Padding="16"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasWorksheetSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Button Width="150"
                            Height="36"
                            Margin="16,0,0,0"
                            DockPanel.Dock="Right"
                            IsEnabled="{Binding IsImportEnabled}"
                            Click="ImportWorksheet_Click"
                            Content="_Import worksheet"
                            AutomationProperties.Name="Import selected worksheet" />
                    <TextBlock Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="#1E3A8A"
                               Text="Worksheet" />
                    <ComboBox MinWidth="220"
                              Height="36"
                              ItemsSource="{Binding WorksheetNames}"
                              SelectedItem="{Binding SelectedWorksheet}"
                              AutomationProperties.Name="Worksheet" />
                </DockPanel>
            </Border>

            <TabControl Grid.Row="2"
                        Background="White"
                        BorderBrush="#CBD5E1">
                <TabItem Header="Preview">
                    <Grid>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#64748B"
                                   FontSize="15"
                                   Text="Choose a CSV or XLSX file to display its rows and inferred values." />
                        <DataGrid ItemsSource="{Binding Preview}"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="All"
                                  BorderThickness="0"
                                  Background="White">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <Trigger Property="ItemsSource" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Profile &amp; mapping"
                         IsEnabled="{Binding HasColumnProfiles}">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Profile name" />
                            <TextBox Grid.Column="1"
                                     Height="34"
                                     Margin="10,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Profile name" />
                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       Text="Saved profiles" />
                            <ComboBox Grid.Column="4"
                                      Height="34"
                                      Margin="10,0,0,0"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding SavedProfiles}"
                                      SelectedItem="{Binding SelectedProfile}"
                                      AutomationProperties.Name="Saved import profile" />
                            <Button Grid.Column="5"
                                    Width="110"
                                    Height="34"
                                    Margin="10,0,0,0"
                                    Click="ApplyProfile_Click"
                                    Content="_Apply"
                                    AutomationProperties.Name="Apply selected profile" />
                            <Button Grid.Column="7"
                                    Width="120"
                                    Height="34"
                                    Click="SaveProfile_Click"
                                    Content="_Save profile"
                                    AutomationProperties.Name="Save import profile" />
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ColumnProfiles}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  FrozenColumnCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="150"
                                                    Header="Source column"
                                                    IsReadOnly="True"
                                                    Binding="{Binding SourceColumn}" />
                                <DataGridTextColumn Width="160"
                                                    Header="Target field"
                                                    Binding="{Binding TargetField, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Width="70"
                                                        Header="Ignore"
                                                        Binding="{Binding IsIgnored, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Width="70"
                                                        Header="Required"
                                                        Binding="{Binding IsRequired, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Width="60"
                                                        Header="Type rule"
                                                        Binding="{Binding ValidateType, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Width="60"
                                                        Header="Email"
                                                        Binding="{Binding ValidateEmail, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Width="60"
                                                        Header="Unique"
                                                        Binding="{Binding IsUnique, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="85"
                                                    Header="Min allowed"
                                                    Binding="{Binding MinimumAllowed, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="85"
                                                    Header="Max allowed"
                                                    Binding="{Binding MaximumAllowed, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="180"
                                                    Header="Allowed values"
                                                    Binding="{Binding AllowedValues, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTemplateColumn Width="95" Header="Severity">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding AvailableSeverities}"
                                                      SelectedItem="{Binding Severity, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="90" Header="Type" IsReadOnly="True" Binding="{Binding TechnicalType}" />
                                <DataGridTextColumn Width="90" Header="Semantic" IsReadOnly="True" Binding="{Binding SemanticType}" />
                                <DataGridTextColumn Width="70" Header="Empty" IsReadOnly="True" Binding="{Binding EmptyCount}" />
                                <DataGridTextColumn Width="70" Header="Unique" IsReadOnly="True" Binding="{Binding UniqueCount}" />
                                <DataGridTextColumn Width="85" Header="Duplicates" IsReadOnly="True" Binding="{Binding DuplicateCount}" />
                                <DataGridTextColumn Width="70" Header="Invalid" IsReadOnly="True" Binding="{Binding InvalidCount}" />
                                <DataGridTextColumn Width="90" Header="Minimum" IsReadOnly="True" Binding="{Binding Minimum}" />
                                <DataGridTextColumn Width="90" Header="Maximum" IsReadOnly="True" Binding="{Binding Maximum}" />
                                <DataGridTextColumn Width="110" Header="Average" IsReadOnly="True" Binding="{Binding Average, StringFormat=N2}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Validation"
                         IsEnabled="{Binding HasColumnProfiles}">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="150" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,12">
                            <Button Width="140"
                                    Height="36"
                                    DockPanel.Dock="Right"
                                    IsEnabled="{Binding IsImportEnabled}"
                                    Click="RunValidation_Click"
                                    Content="Run _validation"
                                    AutomationProperties.Name="Run validation" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Text="{Binding ValidationSummary}" />
                        </DockPanel>

                        <TextBlock Grid.Row="1"
                                   Margin="0,0,0,6"
                                   FontWeight="SemiBold"
                                   Text="Issues" />
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding ValidationIssues}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="70" Header="Row" Binding="{Binding RowNumber}" />
                                <DataGridTextColumn Width="130" Header="Column" Binding="{Binding ColumnName}" />
                                <DataGridTextColumn Width="100" Header="Severity" Binding="{Binding Severity}" />
                                <DataGridTextColumn Width="110" Header="Rule" Binding="{Binding Rule}" />
                                <DataGridTextColumn Width="180" Header="Source value" Binding="{Binding SourceValue}" />
                                <DataGridTextColumn Width="*" Header="Message" Binding="{Binding Message}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="3"
                                   Margin="0,12,0,6"
                                   FontWeight="SemiBold"
                                   Text="Rejected rows" />
                        <DataGrid Grid.Row="4"
                                  ItemsSource="{Binding RejectedRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="80" Header="Row" Binding="{Binding RowNumber}" />
                                <DataGridTextColumn Width="100" Header="Issues" Binding="{Binding IssueCount}" />
                                <DataGridTextColumn Width="*" Header="Current values" Binding="{Binding Values}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Cleaning"
                         IsEnabled="{Binding HasColumnProfiles}">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="230" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,12">
                            <Button Width="140"
                                    Height="36"
                                    DockPanel.Dock="Right"
                                    IsEnabled="{Binding IsImportEnabled}"
                                    Click="RunCleaning_Click"
                                    Content="Run _cleaning"
                                    AutomationProperties.Name="Run cleaning" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Text="{Binding CleaningSummary}" />
                        </DockPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ColumnProfiles}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  FrozenColumnCount="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="150" Header="Source column" IsReadOnly="True" Binding="{Binding SourceColumn}" />
                                <DataGridCheckBoxColumn Width="65" Header="Trim" Binding="{Binding TrimText, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Width="90" Header="Whitespace" Binding="{Binding NormalizeWhitespace, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTemplateColumn Width="90" Header="Case">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding AvailableCaseNormalizations}"
                                                      SelectedItem="{Binding CaseNormalization, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridCheckBoxColumn Width="70" Header="Email" Binding="{Binding NormalizeEmail, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="170" Header="Null tokens" Binding="{Binding NullTokens, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="260" Header="Country aliases (NL=Netherlands)" Binding="{Binding CountryAliases, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Width="70" Header="Date" Binding="{Binding NormalizeDate, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Width="75" Header="Decimal" Binding="{Binding NormalizeDecimal, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2"
                                   Margin="0,12,0,6"
                                   FontWeight="SemiBold"
                                   Text="Before / after review" />
                        <DataGrid Grid.Row="3"
                                  ItemsSource="{Binding CleaningChanges}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="65" Header="Row" Binding="{Binding RowNumber}" />
                                <DataGridTextColumn Width="130" Header="Column" Binding="{Binding ColumnName}" />
                                <DataGridTextColumn Width="130" Header="Rule" Binding="{Binding Rule}" />
                                <DataGridTextColumn Width="180" Header="Before" Binding="{Binding BeforeValue}" />
                                <DataGridTextColumn Width="180" Header="After" Binding="{Binding AfterValue}" />
                                <DataGridTextColumn Width="*" Header="Description" Binding="{Binding Description}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Duplicates"
                         IsEnabled="{Binding HasColumnProfiles}">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="220" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <Button Width="150" Height="36" DockPanel.Dock="Right"
                                    IsEnabled="{Binding IsImportEnabled}"
                                    Click="RunDuplicateDetection_Click"
                                    Content="Find _duplicates"
                                    AutomationProperties.Name="Find duplicates" />
                            <ComboBox Width="150" Margin="0,0,12,0" DockPanel.Dock="Right"
                                      ItemsSource="{Binding AvailableDuplicateActions}"
                                      SelectedItem="{Binding SelectedDuplicateAction}"
                                      AutomationProperties.Name="Duplicate resolution action" />
                            <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                       Text="{Binding DuplicateSummary}" />
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ColumnProfiles}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Header="Source column" IsReadOnly="True" Binding="{Binding SourceColumn}" />
                                <DataGridCheckBoxColumn Width="130" Header="Use as key" Binding="{Binding IsDuplicateKey, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="140" Header="Type" IsReadOnly="True" Binding="{Binding TechnicalType}" />
                                <DataGridTextColumn Width="140" Header="Unique values" IsReadOnly="True" Binding="{Binding UniqueCount}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Margin="0,12,0,6" FontWeight="SemiBold" Text="Duplicate groups" />
                        <DataGrid Grid.Row="3" ItemsSource="{Binding DuplicateGroups}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="80" Header="Group" Binding="{Binding GroupNumber}" />
                                <DataGridTextColumn Width="90" Header="Rows" Binding="{Binding RowCount}" />
                                <DataGridTextColumn Width="220" Header="Source row numbers" Binding="{Binding RowNumbers}" />
                                <DataGridTextColumn Width="*" Header="Exact normalized key" Binding="{Binding KeyValues}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Export &amp; history"
                         IsEnabled="{Binding HasColumnProfiles}">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding ProcessingSummary}" />
                        <DockPanel Grid.Row="1" Margin="0,14,0,14">
                            <Button Width="160" Height="36" Margin="12,0,0,0" DockPanel.Dock="Right"
                                    IsEnabled="{Binding IsImportEnabled}" Click="ExportData_Click" Content="_Export new file"
                                    AutomationProperties.Name="Export new data file" />
                            <Button Width="160" Height="36" Margin="12,0,0,0" DockPanel.Dock="Right"
                                    IsEnabled="{Binding IsImportEnabled}" Click="ExportErrors_Click" Content="Export _error report"
                                    AutomationProperties.Name="Export rejected row error report" />
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Rows" />
                            <ComboBox Width="150" ItemsSource="{Binding AvailableExportFilters}"
                                      SelectedItem="{Binding SelectedExportFilter}"
                                      AutomationProperties.Name="Export row filter" />
                        </DockPanel>
                        <TextBlock Grid.Row="2" Margin="0,4,0,6" FontWeight="SemiBold" Text="Recent local processing history" />
                        <DataGrid Grid.Row="3" ItemsSource="{Binding HistoryEntries}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="150" Header="Started" Binding="{Binding StartedAtUtc, StringFormat={}{0:g}}" />
                                <DataGridTextColumn Width="*" Header="Source" Binding="{Binding SourceFileName}" />
                                <DataGridTextColumn Width="90" Header="Status" Binding="{Binding Status}" />
                                <DataGridTextColumn Width="85" Header="Rows" Binding="{Binding ProcessedRows}" />
                                <DataGridTextColumn Width="85" Header="Invalid" Binding="{Binding InvalidRows}" />
                                <DataGridTextColumn Width="85" Header="Modified" Binding="{Binding ModifiedRows}" />
                                <DataGridTextColumn Width="100" Header="Duplicates" Binding="{Binding DuplicatesRemoved}" />
                                <DataGridTextColumn Width="180" Header="Output" Binding="{Binding OutputFileName}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="#E2E8F0" Padding="28,0">
            <TextBlock VerticalAlignment="Center"
                       Foreground="#334155"
                       AutomationProperties.LiveSetting="Polite"
                       Text="{Binding StatusMessage}" />
        </Border>
    </Grid>
</Window>
