<Window x:Class="DataCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Importer &amp; Cleaner"
        Width="960"
        Height="600"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#0F172A" Padding="28,0">
            <TextBlock VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Text="{Binding ApplicationName}" />
        </Border>

        <Grid Grid.Row="1" Margin="36">
            <Border MaxWidth="720"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Text="Ready for a safe import workflow" />
                    <TextBlock Margin="0,14,0,26"
                               FontSize="15"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               Text="{Binding StatusMessage}" />
                    <Button Width="150"
                            Height="42"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            Content="Select file" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
